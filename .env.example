# Device operational settings. Copy to .env and adjust to the site.
# Report times use the local time zone configured by TZ below.
DEVICE_ENROLLMENT_URL=https://dev.minkafab.com:8444/v1/inscripcion
THREAT_API_URL=https://dev.minkafab.com:8444/api/sincronizar
VOLTAGE_API_URL=https://dev.minkafab.com:8444/api/telemetry/voltage
DEVICE_TELEMETRY_API_URL=https://dev.minkafab.com:8444/api/telemetry/status
STEP_CA_URL=https://dev.minkafab.com:8443
# Install the server's Jocotoco Root CA at this host path before starting Compose.
STEP_CA_CERT_PATH=/home/rpi/client/monitor/certs/root_ca.crt

TZ=America/Guayaquil
REPORTING_TIMES=12:48,14:00,18:00

# Select the relay driven by the ATmega328P: starlink or ubiquiti.
ANTENNA_TYPE=starlink

# Starlink power-on window after a threat, antenna rest interval,
# and scheduled-report connection window (minutes).
TIME_ANTENNA_POWER_ON_MINUTES=10
ANTENNA_REST_TIME_MINUTES=5
REPORTING_TIME_ON_MINUTES=10
STARLINK_CONNECTION_TIMEOUT_SECONDS=420
STARLINK_CONNECTION_CHECK_INTERVAL_SECONDS=60

# Raspberry Pi shutdown threshold. Set only after validating against
# the battery chemistry and the voltage-sensor calibration.
VOLTAGE_TURN_OFF=11.8
